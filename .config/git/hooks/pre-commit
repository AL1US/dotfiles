#!/bin/bash
# Защита от случайного добавления .env и секретов в коммит
FORBIDDEN_FILES=$(git diff --cached --name-only | grep -E "(^|/)(\.env|\.env\..*|\.env.*|.*\.pem|.*\.key)$" || true)

if [ -n "$FORBIDDEN_FILES" ]; then
  echo ""
  echo "🚫 ==================================================================="
  echo "🚫 ЗАЩИТА GIT: ПОПЫТКА ЗАКОММИТИТЬ СЕКРЕТНЫЙ ФАЙЛ!"
  echo "🚫 Обнаружены запрещённые файлы в индексе:"
  echo "$FORBIDDEN_FILES" | sed 's/^/   -> /'
  echo ""
  echo "🚫 Коммит отменён! Файлы .env и приватные ключи заблокированы от попадания в Git."
  echo "🚫 Если это необходимо убрать из индекса: git rm --cached <файл>"
  echo "🚫 ==================================================================="
  echo ""
  exit 1
fi

exit 0
